# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & API credentials (NEVER commit secrets)
.env
.env.local
.env.*.local
*.key
*.pem

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Unit test / coverage / linters
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# Temporary execution run artifacts (audits & intermediate dumps)
artifacts/runs/
artifacts/temp/
artifacts/checkpoint.json
artifacts/dlq.json
artifacts/cache/
*.log

# Operating System & Browser Cache
.DS_Store
Thumbs.db
*.tmp

# IDE / Editor configuration
.vscode/
.idea/
*.swp
*.swo
