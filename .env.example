# Google Gemini API Key
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.5-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-3.5-flash-lite

# Scraper Settings
MITSUBISHI_EOL_URL=https://se-fa.mitsubishielectric.com/fa/se_en/support/product-life-cycle-stage-eol
HEADLESS=true
MAX_ITEMS_TO_PROCESS=50
