# Google Gemini API Key
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-3.8-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Scraper Settings
MITSUBISHI_EOL_URL=https://se-fa.mitsubishielectric.com/fa/se_en/support/product-life-cycle-stage-eol
HEADLESS=true
MAX_ITEMS_TO_PROCESS=50
