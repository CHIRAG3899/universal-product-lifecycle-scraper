# ==============================================================================
# UNIVERSAL MULTI-PROVIDER AI LIFECYCLE SCRAPER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Active AI Intelligence Provider: gemini | openai | anthropic | azure | bedrock | ollama | auto
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite

# 1. Google Gemini (Default Free Tier)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. OpenAI (GPT-4o, GPT-4o-mini, o1, o3)
# Obtain your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Optional custom base URL for proxies or OpenRouter (e.g., https://openrouter.ai/api/v1)
OPENAI_BASE_URL=

# 3. Anthropic Claude (Claude 3.5 Sonnet, Claude 3.5 Haiku)
# Obtain your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. Microsoft Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# 5. Amazon AWS Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION_NAME=us-east-1

# 6. Universal Multi-Provider Token & Cost Optimizations
AI_THINKING_BUDGET=0
AI_ENABLE_PROMPT_CACHING=true
AI_PROMPT_CACHE_TTL=3600s
AI_BATCH_MODE=false

# 7. Crawler & Runtime Settings
HEADLESS=true
MAX_ITEMS_TO_PROCESS=50
WEBHOOK_URL=
